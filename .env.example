# GEMINI_API_KEY: Required for Gemini AI API calls & fallback
GEMINI_API_KEY="AIzaSy..."

# HCNSEC_API_KEY: Required for custom OpenAI-compatible endpoint (e.g. hcnsec)
HCNSEC_API_KEY="sk-..."

# DB_ENCRYPTION_KEY: 32-character key for encrypting local SQLite database rows
DB_ENCRYPTION_KEY="01234567890123456789012345678901"

# FAST_MODEL: Default fast model name (e.g. gemini-2.5-flash or gpt-4o-mini)
FAST_MODEL="gemini-2.5-flash"

# THINKING_MODEL: Default reasoning/thinking model name (e.g. gemini-2.5-pro or o3-mini)
THINKING_MODEL="gemini-2.5-pro"

# APP_URL: Base deployment URL (e.g. https://hcnsecch.vercel.app)
APP_URL="https://hcnsecch.vercel.app"

